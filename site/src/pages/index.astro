---
import Layout from "../layouts/Layout.astro";
import ContentCard from "../components/ContentCard.astro";
import FilterBar from "../components/FilterBar.astro";
import fs from "node:fs";
import path from "node:path";

const dataDir = path.resolve("../data");
let digest = null;
let dates: string[] = [];

if (fs.existsSync(dataDir)) {
  const files = fs.readdirSync(dataDir).filter((f) => f.endsWith(".json")).sort().reverse();
  dates = files.map((f) => f.replace(".json", ""));

  if (files.length > 0) {
    const latest = JSON.parse(fs.readFileSync(path.join(dataDir, files[0]), "utf-8"));
    digest = latest;
  }
}
---

<Layout title="AI Daily Digest">
  <header>
    <div class="header-top">
      <h1>AI Daily Digest</h1>
      <button id="lang-toggle" class="lang-btn">EN</button>
    </div>
    <p>
      <span class="i18n-zh">每日精选 AI 工具动态 · 自动聚合自 6 大平台</span>
      <span class="i18n-en" style="display:none">Daily curated AI updates from 6 platforms</span>
    </p>
    {digest && (
      <div class="stats">
        <span><span class="i18n-zh">日期</span><span class="i18n-en" style="display:none">Date</span>: {digest.date}</span>
        <span><span class="i18n-zh">采集</span><span class="i18n-en" style="display:none">Collected</span>: {digest.stats.totalCollected}</span>
        <span><span class="i18n-zh">精选</span><span class="i18n-en" style="display:none">Selected</span>: {digest.stats.totalPublished}</span>
      </div>
    )}
    {dates.length > 1 && (
      <div class="date-nav">
        {dates.slice(0, 7).map((d) => (
          <a href={`/${d}`}>{d}</a>
        ))}
      </div>
    )}
  </header>

  {digest && digest.items.length > 0 ? (
    <>
      <FilterBar platforms={["youtube", "reddit", "hackernews", "github", "huggingface", "producthunt"]} />
      <div class="cards">
        {digest.items.map((item: any) => (
          <ContentCard
            title={item.title}
            titleEn={item.titleEn}
            summary={item.summary}
            summaryEn={item.summaryEn}
            url={item.url}
            platform={item.platform}
            author={item.author}
            publishedAt={item.publishedAt}
            finalScore={item.finalScore}
            engagement={item.engagement}
          />
        ))}
      </div>
    </>
  ) : (
    <div class="empty-state">
      <p><span class="i18n-zh">暂无内容</span><span class="i18n-en" style="display:none">No content yet</span></p>
      <p><span class="i18n-zh">每日数据将在北京时间 08:00 自动更新</span><span class="i18n-en" style="display:none">Daily data updates at 08:00 Beijing time</span></p>
    </div>
  )}
</Layout>
