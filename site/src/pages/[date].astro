---
import Layout from "../layouts/Layout.astro";
import ContentCard from "../components/ContentCard.astro";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const dataDir = path.resolve("../data");
  if (!fs.existsSync(dataDir)) return [];

  const files = fs.readdirSync(dataDir).filter((f) => f.endsWith(".json"));
  return files.map((f) => ({
    params: { date: f.replace(".json", "") },
  }));
}

const { date } = Astro.params;
const dataDir = path.resolve("../data");
const filePath = path.join(dataDir, `${date}.json`);

let digest = null;
if (fs.existsSync(filePath)) {
  digest = JSON.parse(fs.readFileSync(filePath, "utf-8"));
}

const allDates = fs.existsSync(dataDir)
  ? fs.readdirSync(dataDir).filter((f) => f.endsWith(".json")).map((f) => f.replace(".json", "")).sort().reverse()
  : [];

const CATEGORIES = [
  { key: "all", label: "全部", labelEn: "All" },
  { key: "工具", label: "工具", labelEn: "Tools" },
  { key: "开源", label: "开源", labelEn: "Open Source" },
  { key: "论文", label: "论文", labelEn: "Research" },
  { key: "教程", label: "教程", labelEn: "Tutorials" },
  { key: "讨论", label: "讨论", labelEn: "Discussion" },
];

function countByCategory(items: any[]) {
  const counts: Record<string, number> = { all: items.length };
  for (const item of items) {
    const cat = item.category || "讨论";
    counts[cat] = (counts[cat] || 0) + 1;
  }
  return counts;
}

const counts = digest ? countByCategory(digest.items) : {};
---

<Layout title={`AI Daily Digest - ${date}`} dates={allDates} currentDate={date}>
  <div class="top-bar">
    <div class="top-bar-left">
      <h2 class="page-title">{date}</h2>
      {digest && (
        <div class="stats">
          <span><span class="i18n-zh">采集</span><span class="i18n-en" style="display:none">Collected</span> {digest.stats.totalCollected}</span>
          <span><span class="i18n-zh">精选</span><span class="i18n-en" style="display:none">Selected</span> {digest.stats.totalPublished}</span>
        </div>
      )}
    </div>
    <div class="top-bar-right">
      <button id="lang-toggle" class="lang-btn">EN</button>
    </div>
  </div>

  {digest && digest.items.length > 0 ? (
    <>
      <div class="category-tabs">
        {CATEGORIES.map((cat) => {
          const count = counts[cat.key] || 0;
          if (cat.key !== "all" && count === 0) return null;
          return (
            <button class={`category-tab ${cat.key === "all" ? "active" : ""}`} data-category={cat.key}>
              <span class="i18n-zh">{cat.label}</span>
              <span class="i18n-en" style="display:none">{cat.labelEn}</span>
              <span class="tab-count">{count}</span>
            </button>
          );
        })}
      </div>
      <div class="cards">
        {digest.items.map((item: any) => (
          <ContentCard
            title={item.title}
            titleEn={item.titleEn}
            summary={item.summary}
            summaryEn={item.summaryEn}
            url={item.url}
            platform={item.platform}
            author={item.author}
            publishedAt={item.publishedAt}
            finalScore={item.finalScore}
            engagement={item.engagement}
            category={item.category}
          />
        ))}
      </div>
    </>
  ) : (
    <div class="empty-state">
      <p><span class="i18n-zh">该日期暂无数据</span><span class="i18n-en" style="display:none">No data for this date</span></p>
    </div>
  )}
</Layout>

<script>
  const tabs = document.querySelectorAll(".category-tab");
  const cards = document.querySelectorAll(".card");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => t.classList.remove("active"));
      tab.classList.add("active");

      const category = (tab as HTMLElement).dataset.category;
      cards.forEach((card) => {
        const el = card as HTMLElement;
        if (category === "all" || el.dataset.category === category) {
          el.style.display = "";
        } else {
          el.style.display = "none";
        }
      });
    });
  });
</script>
