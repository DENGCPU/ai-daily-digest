---
import Layout from "../layouts/Layout.astro";
import ContentCard from "../components/ContentCard.astro";
import FilterBar from "../components/FilterBar.astro";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const dataDir = path.resolve("../data");
  if (!fs.existsSync(dataDir)) return [];

  const files = fs.readdirSync(dataDir).filter((f) => f.endsWith(".json"));
  return files.map((f) => ({
    params: { date: f.replace(".json", "") },
  }));
}

const { date } = Astro.params;
const dataDir = path.resolve("../data");
const filePath = path.join(dataDir, `${date}.json`);

let digest = null;
if (fs.existsSync(filePath)) {
  digest = JSON.parse(fs.readFileSync(filePath, "utf-8"));
}
---

<Layout title={`AI Daily Digest - ${date}`}>
  <header>
    <div class="header-top">
      <h1>AI Daily Digest</h1>
      <button id="lang-toggle" class="lang-btn">EN</button>
    </div>
    <p>{date} · <span class="i18n-zh">每日精选 AI 工具动态</span><span class="i18n-en" style="display:none">Daily curated AI updates</span></p>
    {digest && (
      <div class="stats">
        <span><span class="i18n-zh">采集</span><span class="i18n-en" style="display:none">Collected</span>: {digest.stats.totalCollected}</span>
        <span><span class="i18n-zh">精选</span><span class="i18n-en" style="display:none">Selected</span>: {digest.stats.totalPublished}</span>
      </div>
    )}
    <div class="date-nav">
      <a href="/">← <span class="i18n-zh">返回最新</span><span class="i18n-en" style="display:none">Latest</span></a>
    </div>
  </header>

  {digest && digest.items.length > 0 ? (
    <>
      <FilterBar platforms={["hackernews", "github", "huggingface", "producthunt", "arxiv", "devto"]} />
      <div class="cards">
        {digest.items.map((item: any) => (
          <ContentCard
            title={item.title}
            titleEn={item.titleEn}
            summary={item.summary}
            summaryEn={item.summaryEn}
            url={item.url}
            platform={item.platform}
            author={item.author}
            publishedAt={item.publishedAt}
            finalScore={item.finalScore}
            engagement={item.engagement}
          />
        ))}
      </div>
    </>
  ) : (
    <div class="empty-state">
      <p><span class="i18n-zh">该日期暂无数据</span><span class="i18n-en" style="display:none">No data for this date</span></p>
      <a href="/"><span class="i18n-zh">返回最新</span><span class="i18n-en" style="display:none">Back to latest</span></a>
    </div>
  )}
</Layout>
