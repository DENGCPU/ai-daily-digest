---
interface Props {
  title: string;
  dates?: string[];
  currentDate?: string;
}

const { title, dates = [], currentDate } = Astro.props;
import "../styles/global.css";
import SearchBar from "../components/SearchBar.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="AI Daily Digest" href="/rss.xml" />
  </head>
  <body>
    <div class="app-layout">
      <aside class="sidebar">
        <div class="sidebar-header">
          <h1>AI Daily Digest</h1>
          <p><span class="i18n-zh">AI 日报</span><span class="i18n-en" style="display:none">Daily AI Updates</span></p>
        </div>
        <div class="sidebar-section-title">
          <span class="i18n-zh">历史日期</span><span class="i18n-en" style="display:none">Archive</span>
        </div>
        <nav class="sidebar-dates">
          {dates.map((d) => (
            <a href={d === dates[0] ? "/" : `/${d}`} class={d === currentDate ? "active" : ""}>{d}</a>
          ))}
        </nav>
        <div class="sidebar-footer">
          <div class="theme-toggle" id="theme-toggle">
            <span id="theme-icon">☀️</span>
            <span class="i18n-zh">切换主题</span><span class="i18n-en" style="display:none">Toggle theme</span>
          </div>
        </div>
      </aside>

      <main class="main-content">
        <SearchBar />
        <slot />
        <footer>
          <p>Powered by Qwen-Plus · GitHub Actions · Cloudflare Pages</p>
        </footer>
      </main>
    </div>

    <div class="mobile-nav">
      {dates.slice(0, 7).map((d) => (
        <a href={d === dates[0] ? "/" : `/${d}`} class={d === currentDate ? "active" : ""}>{d}</a>
      ))}
    </div>

    <script is:inline>
      (function() {
        // Theme
        var theme = localStorage.getItem("theme") || "light";
        if (theme === "dark") document.documentElement.setAttribute("data-theme", "dark");
        function applyTheme(t) {
          if (t === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            document.documentElement.removeAttribute("data-theme");
          }
          var icon = document.getElementById("theme-icon");
          if (icon) icon.textContent = t === "dark" ? "🌙" : "☀️";
        }
        applyTheme(theme);
        document.addEventListener("click", function(e) {
          var toggle = e.target.closest("#theme-toggle");
          if (toggle) {
            theme = theme === "dark" ? "light" : "dark";
            localStorage.setItem("theme", theme);
            applyTheme(theme);
          }
        });

        // Language
        var lang = localStorage.getItem("lang") || "zh";
        function applyLang(l) {
          var zhEls = document.querySelectorAll(".i18n-zh");
          var enEls = document.querySelectorAll(".i18n-en");
          zhEls.forEach(function(el) { el.style.display = l === "zh" ? "" : "none"; });
          enEls.forEach(function(el) { el.style.display = l === "en" ? "" : "none"; });
          var btn = document.getElementById("lang-toggle");
          if (btn) btn.textContent = l === "zh" ? "EN" : "中";
          document.documentElement.lang = l === "zh" ? "zh-CN" : "en";
        }
        applyLang(lang);
        document.addEventListener("click", function(e) {
          if (e.target && e.target.id === "lang-toggle") {
            lang = lang === "zh" ? "en" : "zh";
            localStorage.setItem("lang", lang);
            applyLang(lang);
          }
        });
      })();
    </script>
  </body>
</html>
