---
interface Props {
  title: string;
}

const { title } = Astro.props;
import "../styles/global.css";
import SearchBar from "../components/SearchBar.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="AI Daily Digest" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="container">
      <SearchBar />
      <slot />
    </div>
    <footer>
      <p>Powered by Gemini Flash · GitHub Actions · Cloudflare Pages</p>
    </footer>
    <script is:inline>
      (function() {
        var lang = localStorage.getItem("lang") || "zh";
        function applyLang(l) {
          var zhEls = document.querySelectorAll(".i18n-zh");
          var enEls = document.querySelectorAll(".i18n-en");
          zhEls.forEach(function(el) { el.style.display = l === "zh" ? "" : "none"; });
          enEls.forEach(function(el) { el.style.display = l === "en" ? "" : "none"; });
          var btn = document.getElementById("lang-toggle");
          if (btn) btn.textContent = l === "zh" ? "EN" : "中";
          document.documentElement.lang = l === "zh" ? "zh-CN" : "en";
        }
        applyLang(lang);
        document.addEventListener("click", function(e) {
          if (e.target && e.target.id === "lang-toggle") {
            lang = lang === "zh" ? "en" : "zh";
            localStorage.setItem("lang", lang);
            applyLang(lang);
          }
        });
      })();
    </script>
  </body>
</html>
