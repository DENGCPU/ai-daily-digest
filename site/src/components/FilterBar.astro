---
interface Props {
  platforms: string[];
}

const { platforms } = Astro.props;

const platformLabels: Record<string, string> = {
  hackernews: "HN",
  github: "GitHub",
  huggingface: "HF Papers",
  producthunt: "Product Hunt",
  arxiv: "arXiv",
  devto: "Dev.to",
};
---

<div class="filter-bar">
  <button class="filter-btn active" data-filter="all">
    <span class="i18n-zh">全部</span><span class="i18n-en" style="display:none">All</span>
  </button>
  {platforms.map((p) => (
    <button class="filter-btn" data-filter={p}>{platformLabels[p] || p}</button>
  ))}
</div>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll(".card");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      buttons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const filter = (btn as HTMLElement).dataset.filter;
      cards.forEach((card) => {
        const el = card as HTMLElement;
        if (filter === "all" || el.dataset.platform === filter) {
          el.style.display = "";
        } else {
          el.style.display = "none";
        }
      });
    });
  });
</script>
