---
interface Props {
  title: string;
  titleEn?: string;
  summary: string;
  summaryEn?: string;
  url: string;
  platform: "youtube" | "reddit" | "hackernews" | "github" | "huggingface" | "producthunt";
  author: string;
  publishedAt: string;
  finalScore: number;
  engagement: {
    views?: number;
    likes?: number;
    score?: number;
    comments?: number;
  };
}

const { title, titleEn, summary, summaryEn, url, platform, author, publishedAt, finalScore, engagement } = Astro.props;

function getScoreClass(score: number): string {
  if (score >= 7) return "score-high";
  return "score-mid";
}

function formatEngagement(platform: string, engagement: any): string {
  switch (platform) {
    case "youtube": {
      const views = engagement.views || 0;
      if (views >= 1000) return `${(views / 1000).toFixed(1)}K views`;
      return `${views} views`;
    }
    case "reddit":
    case "hackernews":
      return `↑${engagement.score || 0} · ${engagement.comments || 0} comments`;
    case "github": {
      const stars = engagement.likes || 0;
      if (stars >= 1000) return `★${(stars / 1000).toFixed(1)}K`;
      return `★${stars}`;
    }
    case "huggingface":
      return `👍${engagement.likes || 0}`;
    case "producthunt":
      return `▲${engagement.likes || 0} · ${engagement.comments || 0} comments`;
    default:
      return `↑${engagement.score || 0}`;
  }
}

function getPlatformLabel(platform: string): string {
  switch (platform) {
    case "hackernews": return "HN";
    case "github": return "GitHub";
    case "huggingface": return "HF Papers";
    case "producthunt": return "PH";
    default: return platform;
  }
}
---

<article class="card" data-platform={platform}>
  <div class="card-header">
    <h3 class="card-title">
      <a href={url} target="_blank" rel="noopener">
        <span class="i18n-zh">{title}</span>
        <span class="i18n-en" style="display:none">{titleEn || title}</span>
      </a>
    </h3>
    <span class={`card-score ${getScoreClass(finalScore)}`}>
      {finalScore.toFixed(1)}
    </span>
  </div>
  <p class="card-summary">
    <span class="i18n-zh">{summary}</span>
    <span class="i18n-en" style="display:none">{summaryEn || summary}</span>
  </p>
  <div class="card-meta">
    <div class="card-meta-left">
      <span class={`platform-tag platform-${platform}`}>{getPlatformLabel(platform)}</span>
      <span>{author}</span>
      <span>·</span>
      <span>{formatEngagement(platform, engagement)}</span>
    </div>
    <a href={url} target="_blank" rel="noopener" class="card-link">
      <span class="i18n-zh">查看原文 →</span>
      <span class="i18n-en" style="display:none">View →</span>
    </a>
  </div>
</article>
